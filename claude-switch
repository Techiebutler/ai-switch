#!/usr/bin/env bash
# claude-switch: save several Claude Code logins and swap between them
# without going through /login again.
#
# Claude Code keeps its login in two places:
#   1. OAuth tokens: macOS Keychain item "Claude Code-credentials"
#      (Linux: ~/.claude/.credentials.json)
#   2. Account identity: the "oauthAccount" key in ~/.claude.json
# A profile is a saved copy of both. Switching writes the saved copy back.
set -euo pipefail

VERSION="1.0.0"
ACTIVE_SERVICE="Claude Code-credentials"
PROFILE_SERVICE_PREFIX="claude-switch:"
STORE_DIR="${CLAUDE_SWITCH_HOME:-$HOME/.claude-switch}"
CONFIG_FILE="$HOME/.claude.json"
LINUX_CREDS_FILE="$HOME/.claude/.credentials.json"

# keychain on macOS, plain 0600 files elsewhere (override for testing)
if [[ -n "${CLAUDE_SWITCH_BACKEND:-}" ]]; then
  BACKEND="$CLAUDE_SWITCH_BACKEND"
elif [[ "$(uname)" == "Darwin" ]]; then
  BACKEND="keychain"
else
  BACKEND="file"
fi

die() { echo "claude-switch: $*" >&2; exit 1; }
info() { echo "$*" >&2; }

command -v python3 >/dev/null || die "python3 is required"
# with a custom config dir Claude Code uses different file and keychain names
[[ -z "${CLAUDE_CONFIG_DIR:-}" ]] || die "CLAUDE_CONFIG_DIR is set; claude-switch only supports the default ~/.claude setup"

# ---------- credential storage ----------

keychain_account_for() {
  # account attribute of an existing item, so we overwrite the same entry
  # a missing item is normal for a new profile, so don't let it abort under pipefail
  { security find-generic-password -s "$1" 2>/dev/null || true; } \
    | sed -n 's/^ *"acct"<blob>="\(.*\)"$/\1/p' | head -n1
}

keychain_read() {
  security find-generic-password -s "$1" -w 2>/dev/null
}

keychain_write() {
  local service="$1" secret="$2" acct
  acct="$(keychain_account_for "$service")"
  acct="${acct:-$USER}"
  # note: the secret is briefly visible to local `ps` while this runs
  security add-generic-password -U -s "$service" -a "$acct" -w "$secret" >/dev/null
}

# The active blob also holds MCP server tokens ("mcpOAuth"). Those are not
# tied to the Claude account, so only the "claudeAiOauth" key is swapped.
read_active_blob() {
  if [[ "$BACKEND" == "keychain" ]]; then
    keychain_read "$ACTIVE_SERVICE"
  else
    [[ -f "$LINUX_CREDS_FILE" ]] && cat "$LINUX_CREDS_FILE"
  fi
}

write_active_blob() {
  if [[ "$BACKEND" == "keychain" ]]; then
    keychain_write "$ACTIVE_SERVICE" "$1"
  else
    mkdir -p "$(dirname "$LINUX_CREDS_FILE")"
    (umask 077; printf '%s' "$1" > "$LINUX_CREDS_FILE.tmp")
    mv "$LINUX_CREDS_FILE.tmp" "$LINUX_CREDS_FILE"
  fi
}

# prints the claudeAiOauth object as JSON, or nothing when logged out
read_active_creds() {
  { read_active_blob || true; } | python3 -c '
import json, sys
raw = sys.stdin.read().strip()
oauth = json.loads(raw).get("claudeAiOauth") if raw else None
if oauth:
    print(json.dumps(oauth))'
}

write_active_creds() {
  local blob
  blob="$({ read_active_blob || true; } | CS_OAUTH="$1" python3 -c '
import json, os, sys
raw = sys.stdin.read().strip()
data = json.loads(raw) if raw else {}
data["claudeAiOauth"] = json.loads(os.environ["CS_OAUTH"])
print(json.dumps(data, separators=(",", ":")))')"
  write_active_blob "$blob"
}

read_profile_creds() {
  if [[ "$BACKEND" == "keychain" ]]; then
    keychain_read "$PROFILE_SERVICE_PREFIX$1"
  else
    cat "$STORE_DIR/$1/credentials.json"
  fi
}

write_profile_creds() {
  if [[ "$BACKEND" == "keychain" ]]; then
    keychain_write "$PROFILE_SERVICE_PREFIX$1" "$2"
  else
    (umask 077; printf '%s' "$2" > "$STORE_DIR/$1/credentials.json")
  fi
}

delete_profile_creds() {
  if [[ "$BACKEND" == "keychain" ]]; then
    security delete-generic-password -s "$PROFILE_SERVICE_PREFIX$1" >/dev/null 2>&1 || true
  fi
}

# ---------- ~/.claude.json oauthAccount ----------

read_oauth_account() {
  [[ -f "$CONFIG_FILE" ]] || { echo null; return; }
  python3 - "$CONFIG_FILE" <<'PY'
import json, sys
with open(sys.argv[1]) as f:
    print(json.dumps(json.load(f).get("oauthAccount")))
PY
}

write_oauth_account() {
  python3 - "$CONFIG_FILE" "$1" <<'PY'
import json, os, sys, tempfile
path, account_file = sys.argv[1], sys.argv[2]
data = {}
if os.path.exists(path):
    with open(path) as f:
        data = json.load(f)
with open(account_file) as f:
    data["oauthAccount"] = json.load(f)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".")
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=2)
if os.path.exists(path):
    os.chmod(tmp, os.stat(path).st_mode & 0o777)
os.replace(tmp, path)
PY
}

# prints "<uuid-or-email>\t<email>" for an oauthAccount JSON on stdin
account_key() {
  python3 -c '
import json, sys
a = json.load(sys.stdin) or {}
print((a.get("accountUuid") or a.get("emailAddress") or "") + "\t" + (a.get("emailAddress") or "?"))'
}

current_key() { read_oauth_account | account_key | cut -f1; }
profile_key() { account_key < "$STORE_DIR/$1/account.json" | cut -f1; }
profile_email() { account_key < "$STORE_DIR/$1/account.json" | cut -f2; }

# ---------- helpers ----------

validate_name() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "profile name may only use letters, digits, '.', '_' and '-'"
}

require_profile() {
  validate_name "$1"
  [[ -f "$STORE_DIR/$1/account.json" ]] || die "no profile named '$1' (see: claude-switch list)"
}

profile_names() {
  [[ -d "$STORE_DIR" ]] || return 0
  for d in "$STORE_DIR"/*/; do
    if [[ -f "$d/account.json" ]]; then basename "$d"; fi
  done
}

# name of the saved profile matching whoever is logged in right now
active_profile() {
  local key name
  key="$(current_key)"
  [[ -n "$key" ]] || return 0
  for name in $(profile_names); do
    if [[ "$(profile_key "$name")" == "$key" ]]; then echo "$name"; return; fi
  done
}

warn_if_running() {
  if pgrep -x 'claude|claude\.exe' >/dev/null 2>&1; then
    info "warning: Claude Code is running. Quit open sessions and start them again after switching,"
    info "         otherwise a running session may keep using (and re-save) the old account."
  fi
}

# Tokens rotate while you use an account, so copy the live ones back into
# its profile before switching away. Otherwise the saved copy goes stale.
sync_active_profile() {
  local name creds
  name="$(active_profile)"
  [[ -n "$name" ]] || return 0
  creds="$(read_active_creds)" || return 0
  [[ -n "$creds" ]] || return 0
  write_profile_creds "$name" "$creds"
  read_oauth_account > "$STORE_DIR/$name/account.json"
}

# ---------- commands ----------

cmd_add() {
  local name="${1:-}" creds oauth existing
  [[ -n "$name" ]] || die "usage: claude-switch add <name>"
  validate_name "$name"
  creds="$(read_active_creds || true)"
  oauth="$(read_oauth_account)"
  [[ -n "$creds" && "$oauth" != "null" ]] || die "not logged in. Run 'claude', then /login, then try again."

  existing="$(active_profile)"
  if [[ -n "$existing" && "$existing" != "$name" ]]; then
    die "this account is already saved as '$existing'"
  fi

  mkdir -p "$STORE_DIR/$name"
  chmod 700 "$STORE_DIR" "$STORE_DIR/$name"
  write_profile_creds "$name" "$creds"
  printf '%s\n' "$oauth" > "$STORE_DIR/$name/account.json"
  info "saved current login ($(profile_email "$name")) as '$name'"
}

cmd_use() {
  local name="${1:-}" creds
  [[ -n "$name" ]] || die "usage: claude-switch use <name>"
  require_profile "$name"

  if [[ "$(active_profile)" == "$name" ]]; then
    info "already using '$name' ($(profile_email "$name"))"
    return
  fi

  warn_if_running
  sync_active_profile

  creds="$(read_profile_creds "$name")" || die "saved credentials for '$name' are missing; re-add it"
  [[ -n "$creds" ]] || die "saved credentials for '$name' are empty; re-add it"
  write_active_creds "$creds"
  write_oauth_account "$STORE_DIR/$name/account.json"
  info "switched to '$name' ($(profile_email "$name")). Start a new 'claude' session to use it."
}

cmd_list() {
  local names active name marker
  names="$(profile_names)"
  [[ -n "$names" ]] || { info "no saved profiles yet. Log in, then run: claude-switch add <name>"; return; }
  active="$(active_profile)"
  for name in $names; do
    marker=" "
    if [[ "$name" == "$active" ]]; then marker="*"; fi
    printf '%s %-16s %s\n' "$marker" "$name" "$(profile_email "$name")"
  done
}

cmd_current() {
  local name
  name="$(active_profile)"
  if [[ -n "$name" ]]; then
    echo "$name ($(profile_email "$name"))"
  else
    echo "logged in as $(read_oauth_account | account_key | cut -f2) (not saved as a profile)"
  fi
}

cmd_remove() {
  local name="${1:-}"
  [[ -n "$name" ]] || die "usage: claude-switch remove <name>"
  require_profile "$name"
  delete_profile_creds "$name"
  rm -rf "${STORE_DIR:?}/$name"
  info "removed profile '$name' (the active login was not changed)"
}

cmd_next() {
  local names active first="" pick="" seen=0 name
  names="$(profile_names)"
  [[ -n "$names" ]] || die "no saved profiles"
  active="$(active_profile)"
  for name in $names; do
    if [[ -z "$first" ]]; then first="$name"; fi
    if (( seen )); then pick="$name"; break; fi
    if [[ "$name" == "$active" ]]; then seen=1; fi
  done
  cmd_use "${pick:-$first}"
}

usage() {
  cat <<'EOF'
claude-switch: swap between saved Claude Code accounts without logging in again

  claude-switch add <name>      save the account you are logged in with now
  claude-switch use <name>      switch to a saved account (or just: claude-switch <name>)
  claude-switch next            rotate to the next saved account
  claude-switch list            show saved accounts (* = active)
  claude-switch current         show the active account
  claude-switch remove <name>   forget a saved account
  claude-switch --version       print the version

Setup: log in to account A, run `add a`. In Claude Code run /login with
account B (do not /logout), then run `add b`. From then on, `use a` / `use b`.
EOF
}

case "${1:-}" in
  add)            shift; cmd_add "$@" ;;
  use|switch)     shift; cmd_use "$@" ;;
  next)           cmd_next ;;
  list|ls|"")     cmd_list ;;
  current|whoami) cmd_current ;;
  remove|rm)      shift; cmd_remove "$@" ;;
  -h|--help|help) usage ;;
  -v|--version|version) echo "claude-switch $VERSION" ;;
  *)              cmd_use "$1" ;;
esac
